# Pantheon — Environment Variables
# Copy this file to .env and fill in your real API keys.
# cp .env.example .env

# Groq API key — used for the routing classifier (llama-smart)
# Get yours at: https://console.groq.com/ (free tier available)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API key — used for coding (deepseek-v4-flash) and orchestration (deepseek-v4-pro)
# Get yours at: https://platform.deepseek.com/
# Optional but required for coding agents and orchestration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Fallback providers (optional) ──────────────────────────────────────────────
# If set, Pantheon will automatically failover to these when DeepSeek is down
# or rate-limited. At least one is recommended for production reliability.

# Anthropic API key — used as first fallback for deepseek-v4-pro
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key — used as second fallback for deepseek-v4-pro
# Get yours at: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here
