# Pantheon — Environment Variables
# Copy this file to .env and fill in your real API keys.
# cp .env.example .env

# Groq API key — used for the routing classifier (llama-smart)
# Get yours at: https://console.groq.com/ (free tier available)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API key — used for coding (deepseek-v4-flash) and orchestration (deepseek-v4-pro)
# Get yours at: https://platform.deepseek.com/
# Optional but required for coding agents and orchestration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Fallback providers (optional) ──────────────────────────────────────────────
# If set, Pantheon will automatically failover to these when DeepSeek is down
# or rate-limited. At least one is recommended for production reliability.

# Anthropic API key — used as first fallback for deepseek-v4-pro
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key — used as second fallback for deepseek-v4-pro
# Get yours at: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# ── Storage (optional) ─────────────────────────────────────────────────────────
# By default Pantheon stores everything in SQLite at ~/.pantheon/pantheon.db.

# Use PostgreSQL instead. The schema is created automatically on first start.
# Move existing data with:  pantheon db migrate --to "$DATABASE_URL"
# DATABASE_URL=postgres://pantheon:pantheon@localhost:5432/pantheon

# Keep SQLite but store the file somewhere else.
# PANTHEON_DB_PATH=/path/to/pantheon.db

# PostgreSQL connection pool size per server process (default: 10).
# PANTHEON_DB_POOL_SIZE=10

# ── Authentication (optional — required before exposing the server) ────────────
# Off by default: the server listens on localhost only and needs no login.
# PANTHEON_AUTH=required
# HOST=0.0.0.0                      # listen on all interfaces (never without PANTHEON_AUTH=required)
# PANTHEON_PUBLIC_URL=https://pantheon.example.com
# PANTHEON_JWT_SECRET=              # 32+ random characters; auto-generated in ~/.pantheon if unset
# PANTHEON_ALLOWED_EMAILS=          # comma-separated; empty = only the first user (owner); * = anyone
# PANTHEON_GITHUB_CLIENT_ID=
# PANTHEON_GITHUB_CLIENT_SECRET=
# PANTHEON_GOOGLE_CLIENT_ID=
# PANTHEON_GOOGLE_CLIENT_SECRET=
# PANTHEON_WORKSPACE=/srv/projects  # remote users may only work inside this directory

# API token for this CLI when it talks to a server that requires auth
# (normally saved by `pantheon auth login` instead).
# PANTHEON_API_TOKEN=pth_...

# ── Isolated command execution (optional) ─────────────────────────────────────
# Run agent shell commands in throw-away Docker containers instead of on the host.
# PANTHEON_EXEC=docker
# PANTHEON_EXEC_IMAGE=node:22-slim
# PANTHEON_EXEC_NETWORK=none        # or "bridge" to allow outbound network

# ── Semantic memory (optional) ────────────────────────────────────────────────
# Needs an embedding model in litellm-config.yaml (pantheon-embed uses OPENAI_API_KEY).
# PANTHEON_EMBEDDING_MODEL=pantheon-embed

# ── Behind a reverse proxy ────────────────────────────────────────────────────
# Rate limits are keyed on the connecting address. Behind a proxy that is the
# proxy itself, so tell Pantheon to use the address the proxy forwards
# (X-Forwarded-For). Never set this when clients connect directly: they could
# then choose their own address and dodge the limits.
# PANTHEON_TRUST_PROXY=1
