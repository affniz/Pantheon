# syntax=docker/dockerfile:1
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json .npmrc ./
COPY packages/shared/ ./packages/shared/
COPY packages/core/ ./packages/core/
COPY packages/server/ ./packages/server/
# cli is a workspace importer in the lockfile — copy its manifest so pnpm
# can resolve the full workspace graph without needing the CLI source
COPY packages/cli/package.json ./packages/cli/package.json

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Build shared → core → server in dependency order
RUN pnpm --filter @pantheon/shared build
RUN pnpm --filter @pantheon/core build
RUN pnpm --filter @pantheon/server build

# ── Production image ──────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

# Copy workspace structure and lockfile
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/core/package.json ./packages/core/
COPY packages/server/package.json ./packages/server/

# Install only production dependencies for the workspace
RUN pnpm install --frozen-lockfile --prod

# Copy built artifacts
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/core/dist ./packages/core/dist
COPY --from=builder /app/packages/server/dist ./packages/server/dist

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "packages/server/dist/index.js"]
